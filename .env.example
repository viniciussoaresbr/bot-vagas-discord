# Copie para .env e preencha. Nunca faça commit do .env.

# Token do bot (Discord Developer Portal → sua aplicação → Bot → Reset Token).
DISCORD_TOKEN=

# ID do canal onde as vagas serão publicadas (Modo Desenvolvedor → "Copiar ID do canal").
DISCORD_JOBS_CHANNEL_ID=

# Opcional. Porta do servidor HTTP interno (padrão: 3000).
# PORT=3000

# Opcional fora do Docker. No compose.yaml é fixado em /app/data/published-jobs.json.
# PUBLISHED_JOBS_FILE=data/published-jobs.json
